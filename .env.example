# Keep the real file outside Git and use an absolute path.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
GOOGLE_SHEET_ID=your-spreadsheet-id

# Local read-only Gradescope adapter. Use a protected credential source outside
# the checkout for deployment; never commit the populated values.
GRADESCOPE_EMAIL=staff-account@example.edu
GRADESCOPE_PASSWORD=replace-with-native-gradescope-password
