# Lab-only Gradescope configuration. Exam 1 is intentionally not enabled here.
# Install outside the checkout as /etc/orie4580-dashboard/gradescope.toml.
schema_version = 1
course_id = 1379687

[roles]
student = ["0"]
non_student = ["1", "2"]

[network]
timeout_seconds = 30
minimum_request_interval_seconds = 0.1
maximum_requests = 20000
maximum_response_bytes = 10000000
minimum_roster_members = 150
maximum_roster_members = 2000
maximum_submissions_per_student = 500

[exam]
assignment_id = 8667062
title = "Exam 1"
expected_question_count = 6
expected_question_score = "1"
earn_threshold = "0.8"

