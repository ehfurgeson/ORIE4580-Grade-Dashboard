# TEST ONLY: proves that either populated course group is received from Shibboleth.
# (Note from Ziv: we aren't using groups anymore because they don't seem to be working reliably.)
AuthType shibboleth
ShibRequestSetting requireSession 1

<RequireAny>
    Require shib-attr groups EN-OR-or4580-students
    Require shib-attr groups EN-OR-or4580-ta
</RequireAny>

<IfModule mod_headers.c>
    Header always set Cache-Control "private, no-store"
</IfModule>
